rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn(); // Allow reading for leaderboard and profiles
      
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().keys().hasAll(['uid', 'name', 'email', 'status', 'totalPoints', 'rank', 'streak'])
                    && incoming().uid == userId
                    && incoming().status == 'active'
                    && incoming().totalPoints == 0;
                    
      allow update: if isOwner(userId)
                    && incoming().diff(existing()).affectedKeys().hasAny(['name', 'mobile', 'class', 'board', 'subjects', 'profilePic', 'totalPoints', 'rank', 'questionsAttempted', 'testsCompleted', 'correctAnswers', 'accuracy', 'badges', 'streak'])
                    && (!('status' in incoming().diff(existing()).affectedKeys()))
                    && (!('uid' in incoming().diff(existing()).affectedKeys()))
                    && (!('email' in incoming().diff(existing()).affectedKeys()));
    }

    // Usernames Collection (For unique check)
    match /usernames/{username} {
      allow read: if true; // Open to check availability during registration
      
      allow create: if isSignedIn()
                    && isValidId(username)
                    && incoming().keys().hasAll(['uid'])
                    && incoming().uid == request.auth.uid;
                    
      allow delete: if isSignedIn()
                    && existing().uid == request.auth.uid;
    }
  }
}
